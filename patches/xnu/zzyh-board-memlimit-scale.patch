  * The CACHE_*** macros are use to cache the limit that will
  * soon be in effect down in the ledgers.
  */
+
+/*
+ * Board (asteroids): sheng-memlimit-scale=<n> (1..16, default 1) multiplies every positive per-process memory limit. Each process
+ * that maps the GPU addon (Turnip, the metal2vulkan bridge, the Metal plugin) carries far more footprint than on the original
+ * tablet, and the original limits then kill small services such as iconservicesagent (per-process-limit), which leaves icons,
+ * widgets and app snapshots unrendered. Zero and negative limits (none) are kept.
+ */
+static int32_t
+sheng_memlimit_scaled(int32_t mb)
+{
+	static int scale = 0;
+	if (scale == 0) {
+		int value = 1;
+		if (!PE_parse_boot_argn("memlimit-scale", &value, sizeof(value)) || value < 1 || value > 16) {
+			value = 1;
+		}
+		scale = value;
+	}
+	return (mb > 0 && mb <= INT32_MAX / scale) ? mb * scale : mb;
+}
 
